---
interface Props {
  title: string;
  description: string;
  image: string;
}

const { title, description, image } = Astro.props;
---

<article class="overflow-hidden rounded-2xl ring-1 ring-white/5">
  <img src={image} alt={title} class="aspect-video w-full object-cover" loading="lazy" />
  <div class="bg-noche-900/60 p-6">
    <h3 class="text-xl text-marfil">{title}</h3>
    <p class="mt-2 text-sm text-marfil/70">{description}</p>
  </div>
</article>
