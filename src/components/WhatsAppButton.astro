---
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { vendedores } from "../data/site";

const enlaces = vendedores.map((vendedor) => ({
  ...vendedor,
  href: `https://wa.me/${vendedor.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(
    `Hola ${vendedor.nombre}, me gustaría recibir más información sobre sus servicios.`,
  )}`,
}));
---

<div class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3">
  {
    enlaces.map((vendedor) => (
      <div class="group relative flex items-center">
        <span class="pointer-events-none absolute right-full mr-3 hidden translate-x-2 rounded-lg bg-noche-900/95 px-4 py-2.5 text-right opacity-0 ring-1 ring-white/10 backdrop-blur transition duration-200 group-hover:translate-x-0 group-hover:opacity-100 group-focus-visible:translate-x-0 group-focus-visible:opacity-100 sm:block">
          <span class="block text-xs font-semibold uppercase tracking-[0.15em] text-champagne-400">
            {vendedor.nombre}
          </span>
          <span class="mt-0.5 block text-sm text-marfil/80">{vendedor.whatsapp}</span>
        </span>

        <a
          href={vendedor.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Contactar por WhatsApp a ${vendedor.nombre}, ${vendedor.whatsapp}`}
          class="inline-flex items-center justify-center rounded-full bg-[#25D366] p-4 text-white shadow-lg transition-transform duration-200 hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-champagne-400"
        >
          <WhatsAppIcon size={26} />
        </a>
      </div>
    ))
  }
</div>