---
interface Props {
  title: string;
  description: string;
  image: string;
}

const { title, description, image } = Astro.props;
---

<article class="group overflow-hidden rounded-2xl bg-noche-800/60 ring-1 ring-white/5 transition duration-300 hover:ring-champagne-500/40">
  <img src={image} alt={title} class="aspect-[4/3] w-full object-cover" loading="lazy" />
  <div class="p-6">
    <h3 class="text-xl text-marfil">{title}</h3>
    <p class="mt-2 text-sm text-marfil/70">{description}</p>
  </div>
</article>
