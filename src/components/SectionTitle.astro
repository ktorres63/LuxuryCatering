---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { eyebrow, title, description, align = "center" } = Astro.props;
---

<div class:list={["mb-12", align === "center" ? "mx-auto max-w-2xl text-center" : "text-left"]}>
  {eyebrow && (
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.35em] text-champagne-500">{eyebrow}</p>
  )}
  <h2 class="text-3xl text-marfil sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-base text-marfil/70">{description}</p>}
</div>
