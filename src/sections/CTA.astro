---
import WhatsAppIcon from "../components/WhatsAppIcon.astro";
import { site, vendedores } from "../data/site";

const enlaces = vendedores.map((vendedor) => ({
  ...vendedor,
  href: `https://wa.me/${vendedor.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(
    `Hola ${vendedor.nombre}, quiero cotizar un evento masivo con ${site.name}.`,
  )}`,
}));

const stats = [
  { value: "11", label: "Servicios integrales para cada ocasión" },
  { value: "100%", label: "Atención personalizada en cada evento" },
  { value: "+8", label: "Tipos de celebración que celebramos" },
];
---

<section class="px-6 py-20">
  <div class="mx-auto max-w-6xl overflow-hidden rounded-3xl p-8 sm:p-12">
    <div class="grid items-start gap-12 md:grid-cols-5">
      <div class="md:col-span-3">
        <h2 class="text-3xl leading-tight text-marfil sm:text-4xl">
          Creamos experiencias para <span class="italic text-champagne-400">grandes momentos.</span>
        </h2>
        <p class="mt-6 max-w-xl text-marfil/70">
          Catering, decoración, mobiliario y servicio de protocolo unidos en una sola
          operación. Tú disfrutas; nosotros nos encargamos de que cada detalle cumpla.
        </p>

        <dl class="mt-10 grid grid-cols-2 gap-8 sm:grid-cols-3">
          {
            stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd>
                  <span class="block font-serif text-4xl text-champagne-400 sm:text-5xl">
                    {stat.value}
                  </span>
                  <span class="mt-2 block max-w-56 text-sm text-marfil/70">
                    {stat.label}
                  </span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="md:col-span-2">
        <div class="rounded-2xl bg-noche-950/70 p-7 ring-1 ring-white/5">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-marfil/50">
            Bodas y eventos masivos
          </p>
          <p class="mt-4 text-sm leading-relaxed text-marfil/70">
            Soluciones integrales de banquetería, ambientación y gastronomía para
            celebraciones a gran escala y eventos corporativos.
          </p>
          <div class="mt-7 flex flex-col gap-3">
            {
              enlaces.map((vendedor) => (
                <a
                  href={vendedor.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Agendar cotización de evento masivo con ${vendedor.nombre} por WhatsApp`}
                  class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-champagne-500 px-6 py-4 text-xs font-semibold uppercase tracking-[0.2em] text-noche-950 transition-colors hover:bg-champagne-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-champagne-400"
                >
                  <WhatsAppIcon size={16} />
                  Cotizar con {vendedor.nombre}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>