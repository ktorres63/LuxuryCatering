---
import Button from "../components/Button.astro";
import heroUrl from "../assets/images/hero/a33a8204-7e26-48b3-b6b9-f9cb86ac8e05.jpeg?url";
import { site, vendedores } from "../data/site";

const vendedor = vendedores[0];

const whatsappCotizacion = `https://wa.me/${vendedor.whatsapp.replace(
  /\D/g,
  "",
)}?text=${encodeURIComponent(
  `Hola ${vendedor.nombre}, quiero agendar una cotización para mi evento con ${site.name}.`,
)}`;
---

<section
  id="inicio"
  class="relative flex min-h-screen items-center justify-center overflow-hidden"
>
  <img
    src={heroUrl}
    alt="Salón elegante con mesa larga decorada con flores blancas"
    class="absolute inset-0 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 bg-linear-to-b from-noche-950/50 via-noche-950/60 to-noche-950"
  >
  </div>
<div class="relative z-10 px-6 text-center md:mx-40 md:text-left">
  <h1 class="text-4xl text-marfil sm:text-5xl md:max-w-4xl md:text-6xl">
    Transformamos tus momentos especiales en <span
      class="text-champagne-400 italic"
      >recuerdos inolvidables.
    </span>
  </h1>

  <p class="mt-6 font-serif text-lg text-marfil/80 md:text-2xl">
    Nos encargamos de cada detalle: desde la planificación y decoración
    temática hasta la alta cocina y el servicio de protocolo. Tú solo disfruta
    y crea hermosos recuerdos; del resto nos encargamos nosotros.
  </p>

  <div
    class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
  >
    <Button href={whatsappCotizacion} target="_blank" variant="primary" class="w-72 md:h-16"
      >Agendar cotización</Button
    >
    <Button href="#servicios" variant="secondary" class="w-72 md:h-16"
      >Ver nuestros servicios</Button
    >
  </div>
</div>
</section>
