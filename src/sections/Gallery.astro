---
import SectionTitle from "../components/SectionTitle.astro";
import { gallery } from "../data/gallery";
---

<section id="galeria" class="bg-noche-900/40 py-24">
  <div class="mx-auto max-w-6xl px-6">
    <SectionTitle
      eyebrow="Galería"
      title="Momentos con firma propia"
      description="Una mirada a nuestros detalles, colores y ambiente."
    />
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
      {gallery.map((item) => (
        <img src={item.src} alt={item.alt} class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
      ))}
    </div>
  </div>
</section>
