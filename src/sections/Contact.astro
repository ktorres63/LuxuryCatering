---
import SectionTitle from "../components/SectionTitle.astro";
import { site } from "../data/site";
---

<section id="contacto" class="py-24">
  <div class="mx-auto max-w-6xl px-6">
    <SectionTitle
      eyebrow="Contacto"
      title="Agenda tu cotización"
      description="Cuéntanos sobre tu celebración. Sin compromiso, respondemos a la brevedad."
    />

    <div class="grid gap-12 md:grid-cols-2">
      <div class="space-y-4 text-sm text-marfil/80">
        <p><span class="font-semibold text-champagne-400">Teléfono:</span> {site.phone}</p>
        <p><span class="font-semibold text-champagne-400">Email:</span> {site.email}</p>
        <p><span class="font-semibold text-champagne-400">Instagram:</span> {site.instagram}</p>
        <p><span class="font-semibold text-champagne-400">Ubicación:</span> {site.location}</p>
      </div>

      <form id="quote-form" class="grid gap-5" novalidate={false}>
        <div>
          <label for="nombre" class="mb-1 block text-xs font-semibold uppercase tracking-[0.2em] text-champagne-500">Nombre</label>
          <input id="nombre" name="nombre" type="text" required autocomplete="name" class="w-full rounded-xl border border-white/10 bg-noche-800/60 px-4 py-3 text-marfil focus:border-champagne-500 focus:outline-none" />
        </div>

        <div>
          <label for="email" class="mb-1 block text-xs font-semibold uppercase tracking-[0.2em] text-champagne-500">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" class="w-full rounded-xl border border-white/10 bg-noche-800/60 px-4 py-3 text-marfil focus:border-champagne-500 focus:outline-none" />
        </div>

        <div>
          <label for="evento" class="mb-1 block text-xs font-semibold uppercase tracking-[0.2em] text-champagne-500">Tipo de evento</label>
          <select id="evento" name="evento" required class="w-full rounded-xl border border-white/10 bg-noche-800/60 px-4 py-3 text-marfil focus:border-champagne-500 focus:outline-none">
            <option value="" disabled selected>Selecciona una opción</option>
            <option>Boda</option>
            <option>XV Años</option>
            <option>50 años / Jubilación</option>
            <option>Infantil</option>
            <option>Despedida de soltero/a</option>
            <option>Evento corporativo</option>
            <option>Otro</option>
          </select>
        </div>

        <div>
          <label for="fecha" class="mb-1 block text-xs font-semibold uppercase tracking-[0.2em] text-champagne-500">Fecha aproximada</label>
          <input id="fecha" name="fecha" type="date" class="w-full rounded-xl border border-white/10 bg-noche-800/60 px-4 py-3 text-marfil focus:border-champagne-500 focus:outline-none" />
        </div>

        <div>
          <label for="mensaje" class="mb-1 block text-xs font-semibold uppercase tracking-[0.2em] text-champagne-500">Mensaje</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class="w-full rounded-xl border border-white/10 bg-noche-800/60 px-4 py-3 text-marfil focus:border-champagne-500 focus:outline-none"></textarea>
        </div>

        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-champagne-500 px-8 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-noche-950 transition hover:bg-champagne-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-champagne-400">
          Agendar cotización
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { site } from "../data/site";

  const form = document.getElementById("quote-form") as HTMLFormElement | null;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const nombre = data.get("nombre");
    const email = data.get("email");
    const evento = data.get("evento");
    const fecha = data.get("fecha");
    const mensaje = data.get("mensaje");

    const text = [
      "Hola, quiero agendar una cotización.",
      `Nombre: ${nombre}`,
      `Email: ${email}`,
      `Tipo de evento: ${evento}`,
      fecha ? `Fecha aproximada: ${fecha}` : "",
      `Mensaje: ${mensaje}`,
    ]
      .filter(Boolean)
      .join("\n");

    const number = site.whatsapp.replace(/\D/g, "");
    const url = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
    window.open(url, "_blank", "noopener");
  });
</script>
