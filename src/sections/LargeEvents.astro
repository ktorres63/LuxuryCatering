---
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
---

<section id="grandes-eventos" class="py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <SectionTitle
      eyebrow="Grandes eventos"
      title="A la altura de tus grandes celebraciones"
      description="Ya vengan ochenta o ochocientos invitados, nuestros estándares de servicio, calidad y elegancia se mantienen. Preparamos bodas a gran escala y eventos corporativos que buscan impresionar sin perder el trato humano que nos define."
    />
    <Button href="#contacto" variant="primary">Agendar cotización</Button>
  </div>
</section>
